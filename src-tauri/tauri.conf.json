{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDP App",
  "version": "0.2.0",
  "identifier": "com.jeromejaja.rdpapp",
  "build": {
    "beforeDevCommand": "bun run dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RDP App",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "transparent": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
